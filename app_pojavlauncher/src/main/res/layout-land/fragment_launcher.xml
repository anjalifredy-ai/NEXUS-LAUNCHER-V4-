<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nexus_bg"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/nexus_nav_rail"
        android:layout_width="52dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@color/nexus_surface_main"
        android:paddingTop="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="N" android:textColor="@color/nexus_orange" android:textStyle="bold" android:textSize="16sp" android:paddingBottom="8dp"/>
        <ImageButton android:id="@+id/nav_home" android:layout_width="44dp" android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_menu_home" android:scaleType="centerInside" android:padding="8dp"/>
        <ImageButton android:id="@+id/nav_profiles" android:layout_width="44dp" android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_edit_profile" android:scaleType="centerInside" android:padding="8dp"/>
        <ImageButton android:id="@+id/nav_mods" android:layout_width="44dp" android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_menu_install_jar" android:scaleType="centerInside" android:padding="8dp"/>
        <ImageButton android:id="@+id/nav_settings" android:layout_width="44dp" android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_menu_settings" android:scaleType="centerInside" android:padding="8dp"/>
        <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1"/>
        <TextView android:id="@+id/nexus_version_label" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:textSize="8sp" android:textColor="@color/nexus_text_muted" android:text="Nexus" android:padding="2dp"/>
    </LinearLayout>

    <ScrollView
        android:id="@+id/nexus_center_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintStart_toEndOf="@id/nexus_nav_rail"
        app:layout_constraintEnd_toStartOf="@id/nexus_right_column"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/nexus_bottom_bar"
        android:layout_marginHorizontal="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <FrameLayout android:id="@+id/nexus_hero" android:layout_width="match_parent" android:layout_height="200dp" android:background="@color/nexus_surface_elevated">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="12dp">
                    <TextView android:id="@+id/nexus_username_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/main_add_account" android:textColor="@color/nexus_text_primary" android:textSize="13sp"
                        android:background="@color/nexus_card" android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:layout_marginBottom="10dp"/>
                    <com.kdt.mcgui.MineButton android:id="@+id/play_button" android:layout_width="260dp" android:layout_height="46dp"
                        android:text="@string/main_play" android:textAllCaps="true" android:textSize="15sp"/>
                </LinearLayout>
            </FrameLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
                <com.kdt.mcgui.LauncherMenuButton android:id="@+id/news_button" style="@style/LauncherMenuButton"
                    android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                    android:drawableStart="@drawable/ic_menu_news" android:text="@string/mcl_tab_wiki" android:textColor="@color/nexus_text_primary"/>
                <View android:id="@+id/social_divider" android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/nexus_border" android:layout_marginHorizontal="4dp"/>
                <com.kdt.mcgui.LauncherMenuButton android:id="@+id/discord_button" style="@style/LauncherMenuButton"
                    android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                    android:drawableStart="@drawable/ic_discord" android:text="@string/mcl_button_discord" android:textColor="@color/nexus_text_primary"/>
            </LinearLayout>
            <com.kdt.mcgui.LauncherMenuButton android:id="@+id/custom_control_button" style="@style/LauncherMenuButton"
                android:layout_width="match_parent" android:layout_height="36dp" android:drawableStart="@drawable/ic_menu_custom_controls"
                android:text="@string/mcl_option_customcontrol" android:textColor="@color/nexus_text_secondary"/>
            <com.kdt.mcgui.LauncherMenuButton android:id="@+id/install_jar_button" style="@style/LauncherMenuButton"
                android:layout_width="match_parent" android:layout_height="36dp" android:drawableStart="@drawable/ic_menu_install_jar"
                android:text="@string/main_install_jar_file" android:textColor="@color/nexus_text_secondary"/>
            <com.kdt.mcgui.LauncherMenuButton android:id="@+id/share_logs_button" style="@style/LauncherMenuButton"
                android:layout_width="match_parent" android:layout_height="36dp" android:drawableStart="@android:drawable/ic_menu_share"
                android:text="@string/main_share_logs" android:textColor="@color/nexus_text_secondary"/>
            <com.kdt.mcgui.LauncherMenuButton android:id="@+id/open_files_button" style="@style/LauncherMenuButton"
                android:layout_width="match_parent" android:layout_height="36dp" android:drawableStart="@drawable/ic_folder"
                android:text="@string/mcl_button_open_directory" android:textColor="@color/nexus_text_secondary"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/nexus_right_column"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@color/nexus_surface_main"
        android:padding="8dp"
        app:layout_constraintWidth_percent="0.22"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/nexus_bottom_bar">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="COMMUNITY" android:textColor="@color/nexus_text_muted" android:textSize="10sp" android:textStyle="bold" android:paddingBottom="6dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Configure community links in Settings." android:textColor="@color/nexus_text_secondary" android:textSize="11sp"
            android:background="@color/nexus_card" android:padding="10dp" android:layout_marginBottom="10dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="FEATURED SERVERS" android:textColor="@color/nexus_text_muted" android:textSize="10sp" android:textStyle="bold" android:paddingBottom="6dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="No featured servers configured." android:textColor="@color/nexus_text_secondary" android:textSize="11sp"
            android:background="@color/nexus_card" android:padding="10dp"/>
    </LinearLayout>

    <View android:id="@+id/_background_display_view" android:layout_width="0dp" android:layout_height="0dp"
        android:background="@color/nexus_surface_elevated"
        app:layout_constraintStart_toEndOf="@id/nexus_nav_rail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/nexus_bottom_bar"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <LinearLayout
        android:id="@+id/nexus_bottom_bar"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="6dp"
        app:layout_constraintStart_toEndOf="@id/nexus_nav_rail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.kdt.mcgui.mcVersionSpinner android:id="@+id/mc_version_spinner"
            android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
            android:background="@android:color/transparent" android:drawableEnd="@drawable/spinner_arrow"
            app:drawableEndPadding="@dimen/_1sdp" app:drawableEndSize="@dimen/_12sdp"
            app:drawableStartIntegerScaling="true" app:drawableStartSize="@dimen/_36sdp"/>
        <ImageButton android:id="@+id/edit_profile_button" android:layout_width="40dp" android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_edit_profile"
            android:scaleType="centerInside" android:padding="6dp"/>
    </LinearLayout>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/center_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5"/>
</androidx.constraintlayout.widget.ConstraintLayout>
