<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nexus_bg"
    android:padding="10dp">
    <TextView android:id="@+id/lib_title" style="@style/Nexus.Title"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Library"/>
    <TextView android:id="@+id/lib_subtitle" style="@style/Nexus.Body"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="8dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingBottom="8dp">
        <Button android:id="@+id/lib_tab_browse" style="@style/Nexus.ChipButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Browse"/>
        <Button android:id="@+id/lib_tab_installed" style="@style/Nexus.ChipButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Installed"/>
        <Button android:id="@+id/lib_btn_home" style="@style/Nexus.ChipButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Home"/>
    </LinearLayout>
    <FrameLayout android:id="@+id/lib_content" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
