<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nexus_bg"
    android:padding="10dp">
    <TextView android:id="@+id/installed_mods_header" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/nexus_text_secondary"
        android:textSize="12sp" android:paddingBottom="8dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/installed_mods_refresh" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Refresh"/>
        <Button android:id="@+id/installed_mods_browse" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Browse mods"/>
        <Button android:id="@+id/installed_mods_back" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Home"/>
    </LinearLayout>
    <ListView android:id="@+id/installed_mods_list" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
