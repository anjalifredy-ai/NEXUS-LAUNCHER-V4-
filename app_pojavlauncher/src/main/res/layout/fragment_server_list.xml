<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/nexus_bg" android:padding="10dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Server Hosting" android:textColor="@color/nexus_accent"
        android:textSize="18sp" android:textStyle="bold"/>
    <TextView android:id="@+id/sl_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/nexus_text_secondary" android:textSize="13sp" android:paddingVertical="8dp"
        android:text="No servers yet. Create one to host Minecraft on this device."/>
    <ListView android:id="@+id/sl_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/sl_create" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Create / Manage"/>
        <Button android:id="@+id/sl_refresh" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Refresh"/>
        <Button android:id="@+id/sl_home" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Home"/>
    </LinearLayout>
</LinearLayout>
