<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/nexus_bg" android:padding="10dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Version Manager" android:textColor="@color/nexus_accent" android:textSize="18sp" android:textStyle="bold"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Official Mojang manifest. Client install via Home profile tools. Server versions are under Servers."
        android:textColor="@color/nexus_text_secondary" android:textSize="11sp" android:paddingBottom="6dp"/>
    <EditText android:id="@+id/vb_search" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Search version id" android:textColor="@color/nexus_text_primary" android:textColorHint="@color/nexus_text_muted"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <CheckBox android:id="@+id/vb_release" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Release" android:checked="true" android:textColor="@color/nexus_text_primary"/>
        <CheckBox android:id="@+id/vb_snapshot" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Snapshot" android:textColor="@color/nexus_text_primary"/>
        <CheckBox android:id="@+id/vb_installed" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Installed only" android:textColor="@color/nexus_text_primary"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/vb_refresh" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Refresh"/>
        <Button android:id="@+id/vb_home" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Home"/>
    </LinearLayout>
    <TextView android:id="@+id/vb_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/nexus_text_muted" android:textSize="12sp"/>
    <ListView android:id="@+id/vb_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
